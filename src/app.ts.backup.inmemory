import express from 'express'
import cors from 'cors'
import morgan from 'morgan'
import { randomUUID } from 'node:crypto'
import { lodgingClassSchema, rateRowSchema, fxSnapshotSchema, taxFeeSchema, promoSchema, quoteRequestSchema, optimizeRequestSchema } from './validators.js'
import type { FXSnapshot, Promo, RateRow, TaxFee, Quote } from './types.js'

const app = express()
app.use(cors())
app.use(express.json())
app.use(morgan('dev'))

// In-memory stores
const lodgingClasses = new Set(['HOSTEL', 'STANDARD', 'PREMIUM'])
const rateTable = new Map<string, RateRow>()
const fxSnaps = new Map<string, FXSnapshot>()
const taxesFees = new Map<string, TaxFee>()
const promos = new Map<string, Promo>()
const quotes = new Map<string, Quote>()

app.get('/health', (_req, res) => res.json({ status: 'ok', service: 'ms-pricing' }))

// Lodging classes
app.get('/lodging-classes', (_req, res) => res.json(Array.from(lodgingClasses)))
app.post('/lodging-classes', (req, res) => {
  const p = lodgingClassSchema.safeParse(req.body)
  if (!p.success) return res.status(400).json({ error: p.error.flatten() })
  lodgingClasses.add(p.data.name)
  res.status(201).json({ name: p.data.name })
})
app.put('/lodging-classes/:name', (req, res) => {
  const oldName = req.params.name
  if (!lodgingClasses.has(oldName)) return res.status(404).json({ error: 'Not found' })
  const p = lodgingClassSchema.safeParse(req.body)
  if (!p.success) return res.status(400).json({ error: p.error.flatten() })
  lodgingClasses.delete(oldName)
  lodgingClasses.add(p.data.name)
  res.json({ name: p.data.name })
})
app.delete('/lodging-classes/:name', (req, res) => {
  const ok = lodgingClasses.delete(req.params.name)
  if (!ok) return res.status(404).json({ error: 'Not found' })
  res.status(204).send()
})

// Rate table
app.get('/rate-table', (_req, res) => res.json(Array.from(rateTable.values())))
app.post('/rate-table', (req, res) => {
  const p = rateRowSchema.safeParse(req.body)
  if (!p.success) return res.status(400).json({ error: p.error.flatten() })
  const id = p.data.id ?? randomUUID()
  const row = { id, ...p.data }
  rateTable.set(id, row)
  res.status(201).json(row)
})
app.put('/rate-table/:id', (req, res) => {
  const id = req.params.id
  if (!rateTable.has(id)) return res.status(404).json({ error: 'Not found' })
  const p = rateRowSchema.partial({ id: true }).safeParse(req.body)
  if (!p.success) return res.status(400).json({ error: p.error.flatten() })
  const updated = { ...rateTable.get(id)!, ...p.data, id }
  rateTable.set(id, updated)
  res.json(updated)
})
app.delete('/rate-table/:id', (req, res) => {
  const ok = rateTable.delete(req.params.id)
  if (!ok) return res.status(404).json({ error: 'Not found' })
  res.status(204).send()
})

// FX snapshots
app.get('/fx-snapshots', (_req, res) => res.json(Array.from(fxSnaps.values())))
app.post('/fx-snapshots', (req, res) => {
  const p = fxSnapshotSchema.safeParse(req.body)
  if (!p.success) return res.status(400).json({ error: p.error.flatten() })
  const id = p.data.id ?? randomUUID()
