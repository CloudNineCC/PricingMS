  const p = fxSnapshotSchema.partial({ id: true }).safeParse(req.body)
  if (!p.success) return res.status(400).json({ error: p.error.flatten() })
  const updated = { ...fxSnaps.get(id)!, ...p.data, id }
  fxSnaps.set(id, updated)
  res.json(updated)
})
app.delete('/fx-snapshots/:id', (req, res) => {
  const ok = fxSnaps.delete(req.params.id)
  if (!ok) return res.status(404).json({ error: 'Not found' })
  res.status(204).send()
})

// Taxes/fees
app.get('/taxes-fees', (_req, res) => res.json(Array.from(taxesFees.values())))
app.post('/taxes-fees', (req, res) => {
  const p = taxFeeSchema.safeParse(req.body)
  if (!p.success) return res.status(400).json({ error: p.error.flatten() })
  const id = p.data.id ?? randomUUID()
  const row = { id, ...p.data }
  taxesFees.set(id, row)
  res.status(201).json(row)
})
app.put('/taxes-fees/:id', (req, res) => {
  const id = req.params.id
  if (!taxesFees.has(id)) return res.status(404).json({ error: 'Not found' })
  const p = taxFeeSchema.partial({ id: true }).safeParse(req.body)
  if (!p.success) return res.status(400).json({ error: p.error.flatten() })
  const updated = { ...taxesFees.get(id)!, ...p.data, id }
  taxesFees.set(id, updated)
